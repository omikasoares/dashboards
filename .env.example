PORT=3000

# Vista 1942 — expoe vendedores, imobiliarias e valores de venda
VISTA1942_USER=
VISTA1942_PASSWORD=

# Reforma Tributária 2026 (Contabilista Play) — matriculas/faturamento/campanhas por cidade da turne
REFORMATRIBUTARIA_USER=
REFORMATRIBUTARIA_PASSWORD=

# Financeiro Autz/We Sales — previsao do mes, alertas, reserva de caixa. Uso interno, restrito ao Mika.
FINANCEIRO_USER=
FINANCEIRO_PASSWORD=

# Revskin — painel de primeira compra x recompra (funil Cliente Clinicaweb, RD CRM)
REVSKIN_USER=
REVSKIN_PASSWORD=

# Anclivepa — Leads Qualificados (snapshot estatico, lista manual x RD CRM)
ANCLIVEPALEADS_USER=
ANCLIVEPALEADS_PASSWORD=

# Contabilista Play — Dash Comercial (vendas Guru + EAD). Separado do Reforma Tributaria.
CPLAYCOMERCIAL_USER=
CPLAYCOMERCIAL_PASSWORD=

# Painel de Tarefas AUTZ (TV do escritorio) - ClickUp: concluidas por pessoa e projetos em andamento
TAREFASTV_USER=
TAREFASTV_PASSWORD=

# Cada cliente novo: duas vars aqui (<PREFIXO>_USER / <PREFIXO>_PASSWORD),
# uma pasta em clients/<slug>/, e uma entrada no array CLIENTS do server.js.
# Todas essas vars vao no stack `environment:` do Portainer, nunca num .env
# na VPS.
